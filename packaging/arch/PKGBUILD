# Maintainer: X-netrunner
# Builds the latest commit. The eBPF half needs a nightly toolchain with rust-src
# (`rustup toolchain install nightly --component rust-src`) and bpf-linker.
pkgname=ai-firewall-git
pkgver=0.2.0
pkgrel=1
pkgdesc="Self-healing eBPF/XDP firewall: automatic bans, blocklist feeds, network profiles, a local-AI helper"
arch=('x86_64')
url="https://github.com/X-netrunner/ai-firewall"
license=('MIT OR Apache-2.0' 'GPL-2.0-only OR MIT')
depends=('gcc-libs' 'glibc' 'curl' 'nftables')
makedepends=('git' 'rustup' 'bpf-linker')
optdepends=('networkmanager: network profiles'
            'libnotify: ban notifications'
            'ollama: the assistant (ai-firewall ask, the dashboard panel)')
provides=('ai-firewall')
conflicts=('ai-firewall')
backup=('etc/ai-firewall/config.toml')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    printf '%s.r%s.%s' "$(sed -n 's/^version = "\(.*\)"/\1/p' ai-firewall/Cargo.toml | head -1)" \
        "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=nightly
    cargo build --release --locked -p ai-firewall
}

check() {
    cd "$pkgname"
    export RUSTUP_TOOLCHAIN=nightly
    # .cargo/config.toml runs binaries through sudo; run the test binary directly
    cargo test --release --locked -p ai-firewall --no-run
    "$(ls -t target/release/build/ai-firewall/*/out/ai_firewall-* | head -1)"
}

package() {
    cd "$pkgname"
    install -Dm755 target/release/ai-firewall "$pkgdir/usr/bin/ai-firewall"
    sed 's|/usr/local/bin/ai-firewall|/usr/bin/ai-firewall|' packaging/ai-firewall.service \
        | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/ai-firewall.service"
    target/release/ai-firewall default-config | install -Dm644 /dev/stdin "$pkgdir/etc/ai-firewall/config.toml"
    install -Dm644 README.md "$pkgdir/usr/share/doc/ai-firewall/README.md"
    install -Dm644 docs/halcyon.md "$pkgdir/usr/share/doc/ai-firewall/halcyon.md"
    install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
    install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
    install -Dm644 LICENSE-GPL2 "$pkgdir/usr/share/licenses/$pkgname/LICENSE-GPL2"
}
